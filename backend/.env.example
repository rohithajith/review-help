# Review App Backend - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Supabase/Postgres Connection
# =============================================================================
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
# URL-encode special characters in the password (e.g., & becomes %26, @ becomes %40)
ADMIN_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# =============================================================================
# OPTIONAL: Server Configuration
# =============================================================================
# Port for the backend server (default: 5002)
PORT=5002

# Environment mode (development or production)
NODE_ENV=production

# Rate limiting: max requests per minute per IP (default: 60 in production, 1000 in dev)
# RATE_LIMIT_MAX=60

# =============================================================================
# OPTIONAL: OpenRouter API (for AI template generation)
# =============================================================================
# Get this from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxx
