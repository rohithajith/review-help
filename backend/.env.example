# Example environment variables for Review App backend (Supabase)
# Copy this file to `backend/.env` and fill in your Supabase connection string.
#
# To get your Supabase Postgres connection string:
# 1. Open your Supabase project dashboard
# 2. Settings -> Database -> Connection string (Postgres)
# 3. Use the full URL (example below)

# Required: Supabase/Postgres connection string (must include user, password, host, port, and database)
ADMIN_DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxx.supabase.co:5432/postgres

# Optional overrides
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3004
# CORS_ORIGINS can be comma-separated (used in production)
# CORS_ORIGINS=https://app.reviewhelp.uk
# Optional DB TLS verification override.
# Set true to strictly verify cert chain, or false when your environment
# uses a self-signed/custom chain (common in some local/proxy setups).
# PG_SSL_REJECT_UNAUTHORIZED=false

# OpenRouter API key (optional) - used for AI template generation
OPENROUTER_API_KEY=

# Cron control: disable background cron jobs locally by setting to 'false'
ENABLE_CRON_JOBS=false

# Cron schedule for template generation (default: daily at 2 AM)
TEMPLATE_GENERATION_CRON="0 2 * * *"

# Optional throttling controls
# RATE_LIMIT_MAX=120
# PUBLIC_WRITE_RATE_LIMIT_MAX=40
# AI_RATE_LIMIT_MAX=12
# LOG_INGEST_RATE_LIMIT_MAX=30
# LOG_READ_RATE_LIMIT_MAX=20
# Review App Backend - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Supabase/Postgres Connection
# =============================================================================
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
# URL-encode special characters in the password (e.g., & becomes %26, @ becomes %40)
ADMIN_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# =============================================================================
# OPTIONAL: Server Configuration
# =============================================================================
# Port for the backend server (default: 5002)
PORT=5002

# Environment mode (development or production)
NODE_ENV=production

# Rate limiting: max requests per minute per IP (default: 60 in production, 1000 in dev)
# RATE_LIMIT_MAX=60

# =============================================================================
# OPTIONAL: OpenRouter API (for AI template generation)
# =============================================================================
# Get this from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxx

# =============================================================================
# SUPABASE (Auth) - required to enable server-side auth middleware
# =============================================================================
# Get these from your Supabase project settings -> API
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
